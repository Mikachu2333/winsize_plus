#include <winres.h>
200 DIALOGEX 0, 0, 334, 197
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "WinSizeP"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Section", 110, 8, 9, 145, 10
    COMBOBOX 101, 8, 22, 149, 115, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Setting", 111, 8, 45, 145, 10
    LISTBOX 102, 8, 58, 149, 104, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP | WS_BORDER
    LTEXT "Value", 112, 166, 9, 160, 10
    COMBOBOX 103, 166, 22, 160, 120, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "Live desktop preview", 104, 166, 48, 160, 14
    LTEXT "", 105, 166, 67, 160, 95
    DEFPUSHBUTTON "Save", IDOK, 209, 173, 56, 16
    PUSHBUTTON "Cancel", IDCANCEL, 270, 173, 56, 16
END
